[Unit]
Description=Crossfire Circuit Colyseus multiplayer server
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=crossfire
Group=crossfire
WorkingDirectory=/opt/crossfire-circuit/current
EnvironmentFile=/etc/crossfire-circuit.env
ExecStart=/usr/bin/node --import tsx server/index.ts
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/crossfire-circuit
MemoryMax=850M
CPUQuota=150%
TasksMax=128
UMask=0077
[Install]
WantedBy=multi-user.target
